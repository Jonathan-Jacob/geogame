<% special = @special %>
<% active_key = special ? "us_states" : "mixed" %>
<% pills = special ? Region::EDITIONS : %w[easy medium hard mixed] %>
<% shape_quiz_params = { mode: "shape", locale: I18n.locale } %>
<% flag_quiz_params = { mode: "flag", locale: I18n.locale } %>
<% if special %>
  <% shape_quiz_params[:edition] = active_key %>
  <% flag_quiz_params[:edition] = active_key %>
<% else %>
  <% shape_quiz_params[:level] = active_key %>
  <% flag_quiz_params[:level] = active_key %>
<% end %>
<div class="flex flex-col flex-1 min-h-0 justify-start gap-5" data-controller="level-picker" data-level-picker-level-value="<%= active_key %>" data-level-picker-param-value="<%= special ? "edition" : "level" %>">
  <div class="text-center">
    <h1 class="font-heading text-3xl sm:text-4xl mb-1"><%= t(special ? "home.special_title" : "home.title") %></h1>
    <p class="text-indigo-900/80 text-sm sm:text-base"><%= t(special ? "home.special_subtitle" : "home.subtitle") %></p>
  </div>

  <div class="flex justify-center gap-2 flex-wrap" role="group" aria-label="<%= t("home.view_label") %>">
    <%= link_to t("home.world_view"), localized_root_path(locale: I18n.locale),
        class: "geo-pill px-3 py-1.5 text-sm rounded-full bg-white #{'is-active' unless special}",
        aria: { current: (special ? nil : "page") } %>
    <%= link_to t("home.special_view"), localized_root_path(locale: I18n.locale, view: "special"),
        class: "geo-pill px-3 py-1.5 text-sm rounded-full bg-white #{'is-active' if special}",
        aria: { current: (special ? "page" : nil) } %>
  </div>

  <div class="flex justify-center gap-2 flex-wrap" role="group" aria-label="<%= t(special ? "home.edition_label" : "home.difficulty_label") %>">
    <% pills.each do |key| %>
      <button type="button"
        data-level-picker-target="pill"
        data-level="<%= key %>"
        data-action="click->level-picker#pick"
        aria-pressed="<%= key == active_key ? 'true' : 'false' %>"
        class="geo-pill px-3 py-1.5 text-sm rounded-full bg-white <%= 'is-active' if key == active_key %>">
        <%= t(special ? "home.editions.#{key}" : "home.#{key}") %>
      </button>
    <% end %>
  </div>

  <div class="grid sm:grid-cols-2 gap-4 sm:gap-6">
    <%= link_to quiz_path(**shape_quiz_params),
        data: { level_picker_target: "link", turbo_action: "replace" },
        class: "geo-card geo-card--shape rounded-2xl p-6 sm:p-8 text-center block -rotate-1 hover:rotate-0" do %>
      <div class="text-5xl mb-2">🗺️</div>
      <h2 class="font-heading text-2xl mb-1"><%= t(special ? "home.special_shape_card_title" : "home.shape_card_title") %></h2>
      <p class="text-sm text-indigo-900/70"><%= t(special ? "home.special_shape_card_text" : "home.shape_card_text") %></p>
    <% end %>

    <%= link_to quiz_path(**flag_quiz_params),
        data: { level_picker_target: "link", turbo_action: "replace" },
        class: "geo-card geo-card--flag rounded-2xl p-6 sm:p-8 text-center block rotate-1 hover:rotate-0" do %>
      <div class="text-5xl mb-2">🏳️</div>
      <h2 class="font-heading text-2xl mb-1"><%= t(special ? "home.special_flag_card_title" : "home.flag_card_title") %></h2>
      <p class="text-sm text-indigo-900/70"><%= t(special ? "home.special_flag_card_text" : "home.flag_card_text") %></p>
    <% end %>
  </div>

  <div class="w-full text-center">
    <%= link_to t("home.cheat_sheet_link"), asset_gallery_path(locale: I18n.locale, view: (special ? "special" : nil)),
        class: "geo-pill inline-block px-4 py-2 text-sm rounded-full bg-white" %>
  </div>
</div>
