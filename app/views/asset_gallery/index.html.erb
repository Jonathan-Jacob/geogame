<div class="asset-gallery-page py-6 w-full">
  <h1 class="font-heading text-2xl mb-1 text-center"><%= t("asset_gallery.title") %></h1>
  <p class="text-sm text-indigo-900/70 mb-6 text-center"><%= t(@special ? "asset_gallery.subtitle_special" : "asset_gallery.subtitle", count: @countries&.size) %></p>

  <% if @special %>
    <% @region_groups.each do |edition, regions| %>
      <section class="asset-gallery-group">
        <h2 class="asset-gallery-group-title"><%= t("home.editions.#{edition}") %></h2>
        <ul class="asset-gallery-grid list-none p-0 m-0">
          <%= render partial: "cell", collection: regions, as: :entry %>
        </ul>
      </section>
    <% end %>
  <% else %>
    <ul class="asset-gallery-grid list-none p-0 m-0">
      <%= render partial: "cell", collection: @countries, as: :entry %>
    </ul>
  <% end %>
</div>
