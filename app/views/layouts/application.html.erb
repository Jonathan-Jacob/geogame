<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title>GeoQuiz — <%= t("app.tagline") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow, noarchive">
    <meta name="description" content="<%= t("app.tagline") %>">
    <meta property="og:title" content="GeoQuiz">
    <meta property="og:description" content="<%= t("app.tagline") %>">
    <meta property="og:type" content="website">
    <% if defined?(protect_against_forgery?) && protect_against_forgery? %>
    <meta name="csrf-param" content="<%= request_forgery_protection_token %>">
    <meta name="csrf-token" content="<%= form_authenticity_token %>">
    <% end %>
    <%= yield :head %>
    <%= render "layouts/font_faces" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="geo-bg font-sans text-indigo-950 antialiased flex flex-col min-h-dvh">
    <header class="shrink-0 px-4 py-2">
      <% on_home = controller_name == "home" && action_name == "index" %>
      <div class="max-w-2xl mx-auto flex items-center justify-between gap-3">
        <%= link_to localized_root_path(locale: I18n.locale), class: "font-heading text-xl tracking-tight hover:opacity-80" do %>
          <%= t("app.name") %>
        <% end %>
        <div class="flex items-center gap-2">
          <%= link_to t("nav.home"), localized_root_path(locale: I18n.locale),
              class: "geo-pill px-3 py-1 text-sm rounded-full bg-white #{"is-active" if on_home}",
              aria: { current: (on_home ? "page" : nil) } %>
          <% other = I18n.locale == :de ? :en : :de %>
          <%= link_to other.to_s.upcase, url_for(locale: other), class: "geo-pill px-3 py-1 text-sm rounded-full bg-white" %>
        </div>
      </div>
    </header>
    <main class="geo-main flex-1 min-h-0 flex flex-col max-w-2xl w-full mx-auto px-4 pb-4">
      <%= yield %>
    </main>
  </body>
</html>
